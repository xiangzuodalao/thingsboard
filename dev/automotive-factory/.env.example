# Local development credentials. Copy this file to .env before first start.
# .env is ignored by Git.
TB_TENANT_USERNAME=tenant@thingsboard.org
TB_TENANT_PASSWORD=tenant
TB_POSTGRES_DB=thingsboard
TB_POSTGRES_USER=postgres
TB_POSTGRES_PASSWORD=postgres
TB_POSTGRES_PORT=5432

# Predictive-maintenance dashboard publication is intentionally a separately
# confirmed operation. Copy the authenticated tenant UUID into the local .env.
TB_PDM_DASHBOARD_MANAGED_PUBLICATION=true
TB_PDM_EXPECTED_TENANT_ID=
# Keep the CMMS work-order action absent unless the isolated closed-loop pilot
# and its same-origin gateway are running.
TB_PDM_MAINTENANCE_ACTIONS_ENABLED=false

# Retain local historical telemetry for seven days (seconds).
SQL_TTL_TS_ENABLED=true
SQL_TTL_TS_TS_KEY_VALUE_TTL=604800

# Rotate each application log at 10 MB and retain two compressed copies.
TB_LOG_ROTATE_SIZE=10M
TB_LOG_ROTATE_COUNT=2

# Keep the development services local to this computer.
HTTP_BIND_ADDRESS=127.0.0.1
MQTT_BIND_ADDRESS=127.0.0.1
COAP_ENABLED=false
COAP_SERVER_ENABLED=false
LWM2M_ENABLED=false
LWM2M_ENABLED_BS=false
SNMP_ENABLED=false
EDGES_ENABLED=false
TB_GATEWAY_DASHBOARD_SYNC_ENABLED=false
